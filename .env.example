# Copy this file to .env.local and fill in the values from
# Supabase dashboard → Project Settings → API.
# .env.local is gitignored — never commit your keys.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-long-anon-public-key-here

# AI features (Sharpen, Friday line, Week card) need the idle-ai Edge Function
# deployed to your Supabase project, with ANTHROPIC_API_KEY set as a secret.
# See supabase/functions/idle-ai/ and the deploy notes in app_build.md.
